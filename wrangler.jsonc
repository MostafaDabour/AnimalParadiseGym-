{
  "name": "animalparadisegym",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // signed parent consent waivers (signature, record, printable copy)
  "r2_buckets": [{ "binding": "WAIVERS", "bucket_name": "apg-waivers" }],
  // GHL inbound webhook; payload field "form" is "parent-consent-waiver" (tour forms send "tour" etc.)
  "vars": { "WAIVER_WEBHOOK": "https://services.leadconnectorhq.com/hooks/31VwWnIDdjlwKYy4I7QI/webhook-trigger/b23536f8-c971-4baa-9478-b0058a9c36c4" },
  "observability": { "enabled": true }
}
